  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="AttributesImpl.h" />
    <ClInclude Include="MediaSource.h" />
    <ClInclude Include="Shared.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ScreenshareHelper.VirtualCamera.def" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
